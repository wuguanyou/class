    for (oo = 1; oo < sm; oo++)
    {
        if (oo % 2 == 1)
        {
            total -= 4.0 / ooo;
        }
        else
        {
            total += 4.0 / ooo;
        }

        ooo += 2;
    }

    printf("%f\n", total);

    
    return 0;
