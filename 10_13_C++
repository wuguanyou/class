#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int yyyy(int n);

int main(void)
{
    int h;

    printf("input your term : ");
    scanf_s("%d", &h);

    printf("%d\n", yyyy(h));

    unsigned int RandNum;
    int Ans;
    int a = 0;

    srand(time(NULL));
    RandNum = rand() % 10 + 1;

    printf("%d\n", RandNum);
    printf("Your Number 1 ~ 10 : ");
    scanf_s("%d", &Ans);

    while (Ans > 10 || Ans < 1)
    {
        printf("Your number is out of field\n");
        printf("Your Number 1 ~ 10 : ");
        scanf_s("%d", &Ans);
    }

   
    while (a == 0)
    {
        
        if (Ans == RandNum)
        {
            printf("Your number is correct, it is %d\n", Ans);
            a = 1;
        }
        else if (Ans < RandNum)
        {
            printf("[Low], try again : ");
            scanf_s("%d", &Ans);
        }
        else
        {
            printf("[High], try again : ");
            scanf_s("%d", &Ans);
        }
    }

    return 0;
}

int yyyy(int n)
{
    if (n == 2)
    {
        return 1;
    }

    if (n <= 1)
    {
        return 0;
    }
    else
    {
        return yyyy(n - 1) + yyyy(n - 2);
    }
}
