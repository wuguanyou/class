#include <stdio.h>

int main() {
    int year;

    printf("input year: ");
    scanf_s("%d", &year);

    if (year % 4 == 0) {
        if (year % 100 == 0) {
            if (year % 400 == 0) {
                printf("leap year");
            }
            else {
                printf("not leap year");
            }
        }
        else {
            printf("leap year");
        }
    }
    else {
        printf("not leap year");
    }

    return 0;
}

